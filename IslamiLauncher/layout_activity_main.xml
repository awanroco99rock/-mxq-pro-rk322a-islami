<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1426"
    android:padding="30dp">

    <TextView android:id="@+id/tvJam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:33"
        android:textSize="72sp"
        android:textColor="#FFFFFF"/>

    <TextView android:id="@+id/tvTanggal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minggu, 01 November 2026"
        android:textColor="#8CA0C0"
        android:textSize="18sp"/>

    <TextView android:id="@+id/tvJawa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jawa: 1 Pahing"
        android:textColor="#FFD700"
        android:textSize="18sp"/>

    <TextView android:id="@+id/tvSholat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subuh 04:42 | Dzuhur 11:55 | Ashar 15:12 | Maghrib 17:56 | Isya 19:05"
        android:textColor="#FFFFFF"
        android:background="#1A2A4A"
        android:padding="16dp"
        android:layout_marginTop="24dp"/>

</LinearLayout>
